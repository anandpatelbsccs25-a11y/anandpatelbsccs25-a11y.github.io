
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="Anand Patel's personal portfolio showcasing programming skills and projects.">
  <title>Anand Patel | Developer Portfolio</title>
  <style>
    :root {
      --bg: #0b1020;
      --panel: #141b30;
      --purple: #8b5cf6;
      --text: #f4f5ff;
      --muted: #aab3ca;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }

    html { scroll-behavior: smooth; scroll-padding-top: 85px; }

    body {
      background: var(--bg);
      color: var(--text);
      font-family: Arial, Helvetica, sans-serif;
      line-height: 1.7;
    }

    a { color: inherit; text-decoration: none; }

    .container { width: min(1080px, 90%); margin: auto; }

    header {
      position: sticky;
      top: 0;
      z-index: 10;
      background: rgba(11,16,32,.95);
      border-bottom: 1px solid #263049;
      backdrop-filter: blur(12px);
    }

    nav {
      min-height: 76px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 20px;
    }

    .logo { font-size: 1.3rem; font-weight: 800; }
    .logo span, .accent { color: var(--purple); }

    .nav-links { display: flex; list-style: none; gap: 25px; }
    .nav-links a { color: var(--muted); font-size: .95rem; }
    .nav-links a:hover { color: white; }

    .menu-btn {
      display: none;
      background: var(--panel);
      color: white;
      border: 1px solid #34405d;
      padding: 8px 12px;
      border-radius: 8px;
      cursor: pointer;
    }

    section { padding: 85px 0; }

    .hero {
      min-height: 78vh;
      display: flex;
      align-items: center;
      background:
        radial-gradient(ellipse at 85% 35%, #49268b44, transparent 42%);
    }

    .eyebrow {
      color: #c4b5fd;
      letter-spacing: 3px;
      font-size: .8rem;
      font-weight: bold;
      text-transform: uppercase;
    }

    h1 {
      font-size: clamp(2.8rem, 7vw, 5rem);
      line-height: 1.12;
      margin: 18px 0;
      letter-spacing: -2px;
    }

    h2 { font-size: clamp(2rem, 4vw, 2.7rem); margin-bottom: 22px; }
    h3 { margin-bottom: 10px; }
    p { color: var(--muted); }

    .hero p { max-width: 650px; font-size: 1.08rem; }

    .buttons { display: flex; gap: 14px; flex-wrap: wrap; margin-top: 28px; }

    .btn {
      display: inline-block;
      padding: 12px 20px;
      border: 1px solid var(--purple);
      border-radius: 9px;
      font-weight: bold;
      transition: .2s;
    }

    .btn.primary { background: var(--purple); }
    .btn:hover { transform: translateY(-2px); opacity: .88; }

    .section-label { color: var(--purple); font-weight: bold; margin-bottom: 8px; }

    .about-grid {
      display: grid;
      grid-template-columns: 1.1fr .9fr;
      gap: 35px;
      align-items: center;
    }

    .panel {
      padding: 28px;
      background: var(--panel);
      border: 1px solid #29334e;
      border-radius: 16px;
    }

    .tags { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 20px; }

    .tag {
      background: #292044;
      border: 1px solid #59418d;
      color: #ddd0ff;
      border-radius: 8px;
      padding: 7px 13px;
      font-size: .9rem;
    }

    .skills-grid, .projects-grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 20px;
      margin-top: 30px;
    }

    .skill-card, .project-card {
      padding: 25px;
      border-radius: 14px;
      background: var(--panel);
      border: 1px solid #29334e;
      transition: .2s;
    }

    .skill-card:hover, .project-card:hover {
      transform: translateY(-5px);
      border-color: var(--purple);
    }

    .skill-icon { font-size: 2rem; margin-bottom: 10px; }

    .project-card { display: flex; flex-direction: column; gap: 12px; }
    .project-card .tags { margin-top: auto; padding-top: 8px; }

    .contact-box { text-align: center; max-width: 700px; margin: auto; }
    .contact-box p { margin-bottom: 18px; }
    .contact-box .buttons { justify-content: center; }

    footer {
      padding: 25px 0;
      text-align: center;
      border-top: 1px solid #263049;
      color: var(--muted);
      font-size: .9rem;
    }

    @media (max-width: 760px) {
      .menu-btn { display: block; }

      .nav-links {
        display: none;
        position: absolute;
        top: 76px;
        left: 0;
        right: 0;
        background: #10172a;
        padding: 20px 5%;
        flex-direction: column;
        gap: 16px;
        border-bottom: 1px solid #263049;
      }

      .nav-links.open { display: flex; }
      .about-grid { grid-template-columns: 1fr; }
      .skills-grid, .projects-grid { grid-template-columns: 1fr; }
      section { padding: 65px 0; }
      .hero { min-height: 75vh; }
      h1 { letter-spacing: -1px; }
    }
  </style>
</head>
<body>
  <header>
    <nav class="container">
      <a class="logo" href="#home">Anand<span>.</span></a>

      <button class="menu-btn" id="menuBtn"
        aria-expanded="false" aria-controls="navLinks">
        Menu ☰
      </button>

      <ul class="nav-links" id="navLinks">
        <li><a href="#home">Home</a></li>
        <li><a href="#about">About</a></li>
        <li><a href="#skills">Skills</a></li>
        <li><a href="#projects">Projects</a></li>
        <li><a href="#contact">Contact</a></li>
      </ul>
    </nav>
  </header>

  <main>
    <section class="hero" id="home">
      <div class="container">
        <div class="eyebrow">Hello, welcome to my portfolio</div>
        <h1>Hi, I'm Anand Patel.<br>
          <span class="accent">Aspiring Developer.</span>
        </h1>
        <p>
          I'm a student passionate about technology, programming,
          and building useful digital experiences. I'm eager to learn,
          take on new challenges, and begin my professional journey.
        </p>
        <div class="buttons">
          <a class="btn primary" href="#projects">Explore My Work ↗</a>
          <a class="btn" href="#contact">Let's Connect</a>
        </div>
      </div>
    </section>

    <section id="about">
      <div class="container about-grid">
        <div>
          <div class="section-label">GET TO KNOW ME</div>
          <h2>About Me</h2>
          <p>
            My name is Anand Patel, and I'm a student developing
            my skills in HTML, Java, and Python. I enjoy exploring
            how software works and turning ideas into practical projects.
          </p>
          <br>
          <p>
            I'm looking for internship and entry-level opportunities
            where I can apply what I've learned, collaborate with others,
            and grow as a developer.
          </p>
        </div>
        <div class="panel">
          <h3>My Career Goals</h3>
          <p>Learn continuously. Build meaningful projects.
            Become a better problem solver.</p>
          <div class="tags">
            <span class="tag">Student</span>
            <span class="tag">Problem Solving</span>
            <span class="tag">Teamwork</span>
            <span class="tag">Internship Ready</span>
          </div>
        </div>
      </div>
    </section>

    <section id="skills">
      <div class="container">
        <div class="section-label">WHAT I'M LEARNING</div>
        <h2>My Skills</h2>
        <p>Technologies I'm learning and using to build my foundation.</p>

        <div class="skills-grid">
          <article class="skill-card">
            <div class="skill-icon">🌐</div>
            <h3>HTML</h3>
            <p>Creating structured web pages and accessible content.</p>
          </article>
          <article class="skill-card">
            <div class="skill-icon">☕</div>
            <h3>Java</h3>
            <p>Learning object-oriented programming and application logic.</p>
          </article>
          <article class="skill-card">
            <div class="skill-icon">🐍</div>
            <h3>Python</h3>
            <p>Practicing programming fundamentals and problem solving.</p>
          </article>
        </div>
      </div>
    </section>

    <section id="projects">
      <div class="container">
        <div class="section-label">WHAT I'M BUILDING</div>
        <h2>My Projects</h2>
        <p>Replace these example ideas with your completed projects.</p>

        <div class="projects-grid">
          <article class="project-card">
            <h3>Personal Portfolio</h3>
            <p>A responsive website to introduce myself and showcase my skills.</p>
            <div class="tags">
              <span class="tag">HTML</span>
              <span class="tag">CSS</span>
            </div>
          </article>
          <article class="project-card">
            <h3>Student Record System</h3>
            <p>A practice application for organizing student details and records.</p>
            <div class="tags">
              <span class="tag">Java</span>
            </div>
          </article>
          <article class="project-card">
            <h3>Python Utility App</h3>
            <p>A small application to automate a repetitive task or solve a daily problem.</p>
            <div class="tags">
              <span class="tag">Python</span>
            </div>
          </article>
        </div>
      </div>
    </section>

    <section id="contact">
      <div class="container contact-box">
        <div class="section-label">LET'S CONNECT</div>
        <h2>Contact Me</h2>
        <p>
          I'm interested in internships, entry-level opportunities,
          and projects that help me grow. Feel free to get in touch.
        </p>
        <div class="buttons">
          <!-- Replace with your actual email address -->
          <a class="btn primary"
             href="mailto:your.email@example.com">Send Me an Email ↗</a>
          <!-- Add your real LinkedIn profile URL -->
          <a class="btn" href="https://www.linkedin.com/"
             target="_blank" rel="noopener noreferrer">LinkedIn ↗</a>
        </div>
      </div>
    </section>
  </main>

  <footer>
    <div class="container">
      © <span id="year"></span> Anand Patel. Built with HTML and CSS.
    </div>
  </footer>

  <script>
    const menuBtn = document.getElementById("menuBtn");
    const navLinks = document.getElementById("navLinks");

    menuBtn.addEventListener("click", () => {
      const isOpen = navLinks.classList.toggle("open");
      menuBtn.setAttribute("aria-expanded", String(isOpen));
      menuBtn.textContent = isOpen ? "Close ✕" : "Menu ☰";
    });

    navLinks.querySelectorAll("a").forEach(link => {
      link.addEventListener("click", () => {
        navLinks.classList.remove("open");
        menuBtn.setAttribute("aria-expanded", "false");
        menuBtn.textContent = "Menu ☰";
      });
    });

    document.getElementById("year").textContent =
      new Date().getFullYear();
  </script>
</body>
</html>
